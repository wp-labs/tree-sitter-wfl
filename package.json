{
  "name": "tree-sitter-wfl",
  "version": "0.1.0",
  "description": "Tree-sitter grammar for WFL (WarpLabs Language)",
  "main": "bindings/node",
  "types": "bindings/node",
  "keywords": [
    "tree-sitter",
    "parser",
    "wfl"
  ],
  "files": [
    "grammar.js",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "completions/**",
    "editor/**",
    "queries/**",
    "scripts/*",
    "src/**"
  ],
  "dependencies": {
    "node-addon-api": "^7.1.0",
    "node-gyp-build": "^4.8.0"
  },
  "peerDependencies": {
    "tree-sitter": "^0.21.0"
  },
  "peerDependenciesMeta": {
    "tree_sitter": {
      "optional": true
    }
  },
  "devDependencies": {
    "tree-sitter-cli": "^0.22.0",
    "prebuildify": "^6.0.0"
  },
  "tree-sitter": [
    {
      "scope": "source.wfl",
      "file-types": [
        "wfl"
      ],
      "highlights": "queries/highlights.scm"
    },
    {
      "scope": "source.wfg",
      "file-types": [
        "wfg"
      ],
      "highlights": "queries/wfg/highlights.scm"
    },
    {
      "scope": "source.wfs",
      "file-types": [
        "wfs"
      ],
      "highlights": "queries/wfs/highlights.scm"
    }
  ],
  "scripts": {
    "install": "node-gyp-build",
    "prebuildify": "prebuildify --napi --strip",
    "build:wasm": "node scripts/build-wasm.mjs",
    "validate:wasm": "node scripts/check-wasm.mjs"
  }
}
